pipeline {
    agent any

    tools {
        // 名称需要和 Jenkins -> Manage Jenkins -> Tools 里配置的一致
        jdk 'jdk17'
        maven 'maven3'
    }

    environment {
        APP_NAME     = 'demo1'
        // pom.xml 在仓库的 demo1 子目录下，不在仓库根目录，构建/打包都要先切到这里
        PROJECT_DIR  = 'demo1'
        JAR_NAME     = 'demo1-0.0.1-SNAPSHOT.jar'
        REMOTE_HOST  = '39.96.35.250'
        REMOTE_USER  = 'deploy'
        REMOTE_DIR   = '/opt/apps/demo1'
        SERVICE_NAME = 'demo1'
        // Jenkins Credentials 里 "SSH Username with private key" 的 ID
        SSH_CRED_ID  = 'deploy-server-ssh'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                // Jenkins 跑在 Windows 上，没有 sh.exe，用 bat 代替
                dir(PROJECT_DIR) {
                    bat 'mvn -B clean package -DskipTests'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${PROJECT_DIR}/target/${JAR_NAME}", fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                // 把 Credentials 里的私钥临时导出成一个文件，供 Windows 自带的 ssh/scp 使用
                withCredentials([sshUserPrivateKey(credentialsId: SSH_CRED_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    bat """
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %SSH_USER%@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR}"
                        if errorlevel 1 exit /b 1

                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" ${PROJECT_DIR}/target/${JAR_NAME} %SSH_USER%@${REMOTE_HOST}:${REMOTE_DIR}/${JAR_NAME}
                        if errorlevel 1 exit /b 1

                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %SSH_USER%@${REMOTE_HOST} "ln -sfn ${REMOTE_DIR}/${JAR_NAME} ${REMOTE_DIR}/app.jar && sudo systemctl restart ${SERVICE_NAME} && sleep 3 && systemctl is-active --quiet ${SERVICE_NAME} && echo deployed || (echo deploy-failed && exit 1)"
                        if errorlevel 1 exit /b 1
                    """
                }
            }
        }
    }

    post {
        success {
            echo "部署成功: ${APP_NAME}"
        }
        failure {
            echo "构建或部署失败，请检查日志"
        }
    }
}
